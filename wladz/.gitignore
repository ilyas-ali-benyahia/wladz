# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# local SQLite data (never commit a database)
/.data/
*.sqlite
*.sqlite3
*.db
*.sqlite-journal
*.sqlite-wal
*.sqlite-shm
*.db-journal
*.db-wal
*.db-shm

# secrets and keys
*.pem
*.key
*.p12
*.pfx
secrets/
credentials*.json
service-account*.json

# generated games registry (see WLADZ_TEAM_PROMPT.md §6.6)
/lib/*.generated.ts

# local developer and agent state
/.wladz-local.json
.claude/settings.local.json
CLAUDE.local.md

# misc
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
*.log

# env files (only the example is committed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts


# local design references for the landing page (never pushed)
/references design landing page/
